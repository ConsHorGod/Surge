#!name=[MitM]排除域名
#!desc=不進入中間人攻擊拆包修改名單

[MITM]
# #>>>>>>>>跳过服务器证书验,安全警告：务必保持 false,确保 SSL 证书真实有效
skip-server-cert-verify = true
# #>>>>>>>开启 HTTP/2 协议支持,提升性能
h2 = true
# 排除名單需在域名前面添加"-"符號
hostname = -*.apple.com, -*.icloud.com, -*.mzstatic.com, -*.facebook.com, -*.instagram.com, -*.twitter.com, -*dropbox*, -*apple*, -*.amazonaws.com